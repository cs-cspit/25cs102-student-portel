# StudentHub .gitignore

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# IDE & Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~

# Environment & Credentials
.env
.env.*
*.config.local.php
credentials.json

# Temporary Files & Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
temp/
tmp/
*.tmp

# Uploaded Files (Keep directory structure but ignore uploaded files in production)
uploads/events/*
!uploads/events/.gitkeep

# Cache & Vendor Directories (if any tooling is used)
.cache/
node_modules/
vendor/
