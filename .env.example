# ============================================================
# STUDENTHUB PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local configuration (kept out of version control)
# ============================================================

# Database Configuration (XAMPP Default)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studenthub
DB_USER=root
DB_PASS=

# Application Settings
APP_NAME="StudentHub Portal"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/studenthub

# Session Configuration
SESSION_LIFETIME=1800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Strict

# Security Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60
